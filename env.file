# ══════════════════════════════════════════════════════════════
#  OSINT--N  |  .env  —  API Keys Configuration
#  Fill in your keys below, then save the file.
#  NEVER commit this file to GitHub — it's in .gitignore
# ══════════════════════════════════════════════════════════════

# ── Hunter.io (Email validation & finder) ──────────────────────
# Get key: https://hunter.io/api-keys
HUNTER_IO_API_KEY=

# ── HaveIBeenPwned (Breach database lookup) ────────────────────
# Get key: https://haveibeenpwned.com/API/Key
HAVEIBEENPWNED_API_KEY=

# ── Shodan (IP / device intelligence) ─────────────────────────
# Get key: https://account.shodan.io/
SHODAN_API_KEY=

# ── IPInfo (IP geolocation) ────────────────────────────────────
# Get token (free tier available): https://ipinfo.io/account/token
IPINFO_TOKEN=

# ── VirusTotal (Domain / IP / file reputation) ────────────────
# Get key: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# ── SecurityTrails (DNS history / subdomain lookup) ────────────
# Get key: https://securitytrails.com/app/account/credentials
SECURITYTRAILS_API_KEY=

# ── NumVerify (Phone number validation) ────────────────────────
# Get key: https://numverify.com/product
NUMVERIFY_API_KEY=

# ── EmailRep (Email reputation scoring) ────────────────────────
# Get key: https://emailrep.io/key
EMAILREP_API_KEY=
