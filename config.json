{
  "_readme": "OSINT--N config v3.0.0 — API keys go in .env, not here.",

  "general": {
    "tool_name": "OSINT--N",
    "version": "3.0.0",
    "output_dir": "./results",
    "log_level": "INFO",
    "timeout_seconds": 15,
    "max_threads": 20,
    "save_results": true,
    "export_formats": ["json", "csv", "html"]
  },

  "modules": {
    "email":      true,
    "domain":     true,
    "ip":         true,
    "username":   true,
    "phone":      true,
    "subdomain":  true,
    "metadata":   true,
    "portscan":   true
  },

  "proxy": {
    "enabled": false,
    "http":  "http://127.0.0.1:8080",
    "https": "https://127.0.0.1:8080"
  },

  "rate_limiting": {
    "requests_per_second": 5,
    "retry_attempts": 3,
    "retry_delay_seconds": 3
  },

  "dns_record_types": ["A", "AAAA", "MX", "NS", "TXT", "SOA", "CNAME"],

  "port_scan": {
    "timeout_seconds": 2,
    "scan_top_ports": true
  },

  "social_media_platforms": [
    "github", "twitter", "instagram", "reddit", "tiktok",
    "pinterest", "twitch", "youtube", "telegram", "snapchat",
    "facebook", "linkedin", "tumblr", "flickr", "vimeo",
    "gitlab", "bitbucket", "medium", "devto", "hackerone",
    "bugcrowd", "codepen", "replit", "stackoverflow",
    "soundcloud", "spotify", "bandcamp", "lastfm",
    "behance", "dribbble", "deviantart", "artstation",
    "steam", "roblox", "lichess", "chess",
    "pastebin", "keybase", "producthunt", "vk",
    "mastodon", "bluesky", "linktree"
  ]
}
