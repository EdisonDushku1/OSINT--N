{
  "_readme": "OSINT--N config v2.0.0 — API keys go in .env, not here.",

  "general": {
    "tool_name": "OSINT--N",
    "version": "2.0.0",
    "output_dir": "./results",
    "log_level": "INFO",
    "timeout_seconds": 15,
    "max_threads": 10,
    "save_results": true,
    "export_formats": ["json", "csv", "html"]
  },

  "modules": {
    "email":      true,
    "domain":     true,
    "ip":         true,
    "username":   true,
    "phone":      true,
    "subdomain":  true,
    "metadata":   true
  },

  "proxy": {
    "enabled": false,
    "http":  "http://127.0.0.1:8080",
    "https": "https://127.0.0.1:8080"
  },

  "rate_limiting": {
    "requests_per_second": 2,
    "retry_attempts": 3,
    "retry_delay_seconds": 5
  },

  "dns_record_types": ["A", "AAAA", "MX", "NS", "TXT", "SOA", "CNAME"],

  "social_media_platforms": [
    "github", "twitter", "instagram", "reddit", "tiktok",
    "pinterest", "twitch", "youtube", "telegram", "snapchat",
    "soundcloud", "spotify", "pastebin", "keybase", "gitlab",
    "medium", "devto", "hackerone", "bugcrowd", "producthunt"
  ]
}
