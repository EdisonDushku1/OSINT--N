"""
OSINT--N | Module: IP Lookup + Geolocation + ASN + Threat Intel
"""

import os
import socket
import requests
from rich.console import Console
from rich.table import Table
from rich import box

console = Console()

def run(target: str, config: dict) -> dict:
    console.rule(f"[bold cyan] IP LOOKUP — {target}")
    data = {"module": "ip", "target": target}
    timeout = config["general"]["timeout_seconds"]

    # Resolve hostname → IP
    try:
        resolved = socket.gethostbyname(target)
        if resolved != target:
            data["resolved_ip"] = resolved
            console.print(f"  [dim]Resolved [bold]{target}[/bold] → {resolved}[/dim]\n")
        ip = resolved
    except Exception as e:
        data["resolve_error"] = str(e)
        ip = target

    # ── ipinfo.io — geo + org ─────────────────
    try:
        r = requests.get(
            f"https://ipinfo.io/{ip}/json",
            timeout=timeout,
            headers={"Accept": "application/json"},
        ).json()
        data["ip"]        = r.get("ip", "N/A")
        data["hostname"]  = r.get("hostname", "N/A")
        data["city"]      = r.get("city", "N/A")
        data["region"]    = r.get("region", "N/A")
        data["country"]   = r.get("country", "N/A")
        data["location"]  = r.get("loc", "N/A")
        data["org"]       = r.get("org", "N/A")
        data["timezone"]  = r.get("timezone", "N/A")
        data["postal"]    = r.get("postal", "N/A")
        if data["location"] and data["location"] != "N/A":
            data["google_maps"] = f"https://maps.google.com/?q={data['location']}"
    except Exception as e:
        data["ipinfo_error"] = str(e)

    # ── ipapi.co — extra ASN / currency data ──
    try:
        r = requests.get(
            f"https://ipapi.co/{ip}/json/",
            timeout=timeout,
            headers={"User-Agent": "OSINT-N/3.0"},
        ).json()
        data["asn"]           = r.get("asn", "N/A")
        data["org_name"]      = r.get("org", "N/A")
        data["isp"]           = r.get("isp", "N/A")
        data["country_name"]  = r.get("country_name", "N/A")
        data["currency"]      = r.get("currency", "N/A")
        data["calling_code"]  = r.get("country_calling_code", "N/A")
        data["languages"]     = r.get("languages", "N/A")
    except Exception as e:
        data["ipapi_error"] = str(e)

    # ── Reverse DNS ───────────────────────────
    try:
        data["reverse_dns"] = socket.gethostbyaddr(ip)[0]
    except Exception:
        data["reverse_dns"] = "N/A"

    # ── AbuseIPDB — threat intel ──────────────
    abuse_key = os.getenv("ABUSEIPDB_API_KEY", "")
    if abuse_key:
        try:
            r = requests.get(
                "https://api.abuseipdb.com/api/v2/check",
                params={"ipAddress": ip, "maxAgeInDays": 90, "verbose": True},
                headers={"Key": abuse_key, "Accept": "application/json"},
                timeout=timeout,
            ).json().get("data", {})
            score = r.get("abuseConfidenceScore", 0)
            data["abuse_confidence_score"] = f"{score}%"
            data["abuse_total_reports"]    = r.get("totalReports", 0)
            data["abuse_last_reported"]    = r.get("lastReportedAt", "N/A")
            data["abuse_is_whitelisted"]   = r.get("isWhitelisted", False)
            data["abuse_usage_type"]       = r.get("usageType", "N/A")
            if score >= 80:
                console.print(f"\n  [bold red][!] HIGH ABUSE SCORE: {score}% — This IP is likely malicious![/bold red]\n")
            elif score >= 30:
                console.print(f"\n  [yellow][!] Moderate abuse score: {score}%[/yellow]\n")
        except Exception as e:
            data["abuseipdb_error"] = str(e)
    else:
        data["abuseipdb"] = "No API key (add ABUSEIPDB_API_KEY to .env)"

    # ── Shodan — open ports/services ──────────
    shodan_key = os.getenv("SHODAN_API_KEY", "")
    if shodan_key:
        try:
            r = requests.get(
                f"https://api.shodan.io/shodan/host/{ip}",
                params={"key": shodan_key},
                timeout=timeout,
            ).json()
            ports = r.get("ports", [])
            data["shodan_ports"]       = ", ".join(str(p) for p in ports[:20]) or "N/A"
            data["shodan_os"]          = r.get("os", "N/A")
            data["shodan_last_update"] = r.get("last_update", "N/A")
            data["shodan_tags"]        = ", ".join(r.get("tags", [])) or "N/A"
            vulns = r.get("vulns", {})
            data["shodan_vulns"]       = ", ".join(vulns.keys()) if vulns else "None"
            if vulns:
                console.print(f"\n  [bold red][!] Shodan found {len(vulns)} CVE(s): {', '.join(list(vulns.keys())[:5])}[/bold red]\n")
        except Exception as e:
            data["shodan_error"] = str(e)
    else:
        data["shodan"] = "No API key (add SHODAN_API_KEY to .env)"

    _print_table("IP Intelligence Report", data)
    return data


def _print_table(title, data):
    t = Table(title=title, box=box.ROUNDED, border_style="cyan", title_style="bold cyan")
    t.add_column("Field", style="bold yellow", no_wrap=True)
    t.add_column("Value", style="white")
    for k, v in data.items():
        if k == "module":
            continue
        val = str(v) if v else "[dim]N/A[/dim]"
        if "abuse_confidence" in k and "%" in val:
            score = int(val.replace("%", ""))
            val = f"[red]{val}[/red]" if score >= 50 else f"[yellow]{val}[/yellow]" if score >= 20 else f"[green]{val}[/green]"
        t.add_row(str(k), val)
    console.print(t)
