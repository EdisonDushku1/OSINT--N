NOT_FOUND_INDICATORS = [
    "not found", "doesn't exist", "no results", "page not found",
    "404", "user not found", "this account doesn't exist",
    "sorry, this page isn't available", "this page isn't available",
    "not available", "no user found", "profile not found",
]

async def check_platform(client: httpx.AsyncClient, platform: str, url: str, username: str) -> dict:
    try:
        r = await client.get(url, timeout=10, follow_redirects=True)
        body = r.text.lower()
        # 404 = definitely not found
        if r.status_code == 404:
            found = False
        elif r.status_code == 200:
            found = not any(x in body for x in NOT_FOUND_INDICATORS)
        else:
            found = False
        return {"platform": platform, "url": url, "status": r.status_code, "found": found}
    except Exception:
        return {"platform": platform, "url": url, "status": "error", "found": False}

async def _run_async(username: str) -> list:
    headers = {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
        "Accept-Language": "en-US,en;q=0.9",
    }
    async with httpx.AsyncClient(headers=headers, follow_redirects=True) as client:
        tasks = [
            check_platform(client, platform, url.format(username), username)
            for platform, url in PLATFORMS.items()
        ]
        results = await asyncio.gather(*tasks)
    return list(results)

def run(target: str, config: dict) -> dict:
    console.rule(f"[bold cyan] USERNAME SEARCH — {target}")
    data = {"module": "username", "target": target}

    console.print(f"\n  [dim]Checking {len(PLATFORMS)} platforms asynchronously...[/dim]\n")
    results = asyncio.run(_run_async(target))

    found_results  = sorted([r for r in results if r["found"]],     key=lambda x: x["platform"])
    missing_results = sorted([r for r in results if not r["found"]], key=lambda x: x["platform"])

    # Found table
    if found_results:
        t = Table(
            title=f"[green]✔ Found — {target}[/green]",
            box=box.ROUNDED,
            border_style="green",
            title_style="bold green",
        )
        t.add_column("Platform", style="bold yellow", no_wrap=True)
        t.add_column("URL",      style="cyan")
        for res in found_results:
            t.add_row(res["platform"], res["url"])
            data[f"found_{res['platform'].lower().replace('.','_').replace('/','_')}"] = res["url"]
        console.print(t)

    # Not found table (compact)
    not_found_names = " · ".join(r["platform"] for r in missing_results)
    console.print(f"\n  [dim]Not found on:[/dim] [dim red]{not_found_names}[/dim red]\n")

    data["found_count"]     = len(found_results)
    data["found_platforms"] = ", ".join(r["platform"] for r in found_results)
    data["checked_total"]   = len(PLATFORMS)
    console.print(
        f"  [bold green]Found on {len(found_results)} platform(s)[/bold green] "
        f"[dim]out of {len(PLATFORMS)} checked.[/dim]\n"
    )
    return data
