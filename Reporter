def _make_summary(data: dict, module: str) -> str:
    cards = []
    if module == "username":
        cards.append(("found_count",   "Platforms Found",  data.get("found_count", 0)))
        cards.append(("checked_total", "Total Checked",    data.get("checked_total", 0)))
    elif module == "subdomain":
        cards.append(("total_found",   "Subdomains Found", data.get("total_found", 0)))
        cards.append(("crtsh_count",   "Via crt.sh",       data.get("crtsh_count", 0)))
        cards.append(("wordlist_count","Via Wordlist",      data.get("wordlist_count", 0)))
    elif module == "portscan":
        cards.append(("open_count",    "Open Ports",       data.get("open_count", 0)))
    elif module == "email":
        cards.append(("breaches_found","Breaches Found",   data.get("breaches_found", "?")))
        cards.append(("disposable",    "Disposable",       "Yes" if data.get("disposable_email") else "No"))

    if not cards:
        return ""

    inner = "".join(
        f'<div class="stat-card"><div class="num">{v}</div><div class="label">{label}</div></div>'
        for _, label, v in cards
    )
    return f'<div class="summary-grid">{inner}</div>'


def save(data: dict, config: dict):
    if not config["general"].get("save_results", True):
        return

    out_dir = Path(config["general"]["output_dir"])
    out_dir.mkdir(parents=True, exist_ok=True)

    target    = str(data.get("target", "unknown")).replace("@", "_at_").replace(".", "_").replace("/", "_")
    module    = data.get("module", "scan")
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    base      = f"{module}_{target}_{timestamp}"
    formats   = config["general"].get("export_formats", ["json"])
    saved     = []

    # JSON
    if "json" in formats:
        p = out_dir / f"{base}.json"
        with open(p, "w") as f:
            json.dump(data, f, indent=2, default=str)
        saved.append(str(p))

    # CSV
    if "csv" in formats:
        p = out_dir / f"{base}.csv"
        flat = {str(k): str(v) for k, v in data.items()}
        with open(p, "w", newline="") as f:
            writer = csv.DictWriter(f, fieldnames=flat.keys())
            writer.writeheader()
            writer.writerow(flat)
        saved.append(str(p))

    # HTML
    if "html" in formats:
        p = out_dir / f"{base}.html"
        rows = ""
        for k, v in data.items():
            if k == "module":
                continue
            val = str(v) if v is not None else "N/A"
            css = ""
            if val in ("N/A", "None", ""):
                css = "val-na"
            elif any(x in val.lower() for x in ["missing", "danger", "spoofing"]):
                css = "val-missing"
            elif any(x in val.lower() for x in ["warn", "⚠"]):
                css = "val-warn"
            elif any(x in k.lower() for x in ["found", "valid", "open"]) and str(v).lower() in ("true", "yes", "✔"):
                css = "val-found"
            rows += f'<tr><td>{k}</td><td class="{css}">{val}</td></tr>\n'

        html = HTML_TEMPLATE.format(
            module=module.upper(),
            target=data.get("target", "unknown"),
            timestamp=datetime.now().strftime("%Y-%m-%d %H:%M:%S UTC"),
            rows=rows,
            summary_section=_make_summary(data, module),
        )
        p.write_text(html, encoding="utf-8")
        saved.append(str(p))

    for s in saved:
        console.print(f"  [dim green]✔ Saved → {s}[/dim green]")
